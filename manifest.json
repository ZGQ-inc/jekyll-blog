---
layout: none
---
{
  "name": {{ site.pwa.name | default: site.title | jsonify }},
  "short_name": {{ site.pwa.short_name | default: site.title | jsonify }},
  "description": {{ site.pwa.description | default: site.description | jsonify }},
  "start_url": "{{ '/' | relative_url }}",
  "scope": "{{ '/' | relative_url }}",
  "id": "{{ '/' | relative_url }}",
  "display": {{ site.pwa.display | default: "standalone" | jsonify }},
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "{{ site.pwa.background_color | default: '#1A1C1E' }}",
  "theme_color": "{{ site.pwa.theme_color | default: '#1A1C1E' }}",
  "icons": [
    {
      "src": "{{ '/assets/images/icons/icon-192.png' | relative_url }}",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "{{ '/assets/images/icons/icon-192-maskable.png' | relative_url }}",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "{{ '/assets/images/icons/icon-512.png' | relative_url }}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "{{ '/assets/images/icons/icon-512-maskable.png' | relative_url }}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "{{ '/logo.png' | relative_url }}",
      "sizes": "192x192 512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "{{ '/logo-monochrome.png' | relative_url }}",
      "sizes": "192x192 512x512",
      "type": "image/png",
      "purpose": "monochrome"
    }
  ]
}
