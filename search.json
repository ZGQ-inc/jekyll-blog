---
layout: none
---
[
  {% for post in site.posts %}
  {
    "title"    : {{ post.title | jsonify }},
    "url"      : {{ post.url | relative_url | jsonify }},
    "date"     : {{ post.date | date: "%Y-%m-%d" | jsonify }},
    "tags"     : {{ post.tags | join: ", " | jsonify }},
    "content"  : {% if post.restricted and post.summary %}{{ post.summary | jsonify }}{% elsif post.content %}{{ post.content | strip_html | strip_newlines | truncate: 5000 | jsonify }}{% else %}{{ "" | jsonify }}{% endif %},
    "restricted" : {% if post.restricted %}true{% else %}false{% endif %}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
