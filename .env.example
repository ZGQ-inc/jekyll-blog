# ==========================================================
# Jekyll Blog + Cloudflare + Telegram 环境变量模板
# 复制此文件为 .env（本地开发），或在 GitHub Secrets / Cloudflare Secrets 中配置
# ==========================================================

# ----------------------------------------------------------
# Telegram Bot
# 通过 @BotFather 创建 Bot 获取
# ----------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram 频道 ID（通常为 @channel_name 或数字 ID）
TELEGRAM_CHANNEL_ID=@your_channel_here

# Webhook 验证密钥（随机字符串，用于验证 TG Webhook 请求合法性）
WEBHOOK_SECRET=your_random_webhook_secret_here

# ----------------------------------------------------------
# GitHub
# 用于 Worker 通过 API 提交 .md 文件到仓库
# 创建: GitHub → Settings → Developer settings → Personal access tokens
# 权限: repo (full control)
# ----------------------------------------------------------
GITHUB_TOKEN=ghp_your_token_here
GITHUB_REPO=your_username/your_repo_name

# ----------------------------------------------------------
# Cloudflare
# 用于 GitHub Actions 部署 Pages
# 创建: Cloudflare Dashboard → My Profile → API Tokens
# ----------------------------------------------------------
CF_API_TOKEN=your_cloudflare_api_token_here
CF_ACCOUNT_ID=your_cloudflare_account_id_here

# Cloudflare Pages 项目名称
CF_PAGES_PROJECT_NAME=blog-zgqinc

# ----------------------------------------------------------
# Worker 内部通信密钥
# GitHub Actions 调用 /api/notify 时使用的 Bearer Token
# 用 openssl rand -hex 32 生成
# ----------------------------------------------------------
NOTIFY_SECRET=your_random_notify_secret_here

# ----------------------------------------------------------
# 站点配置（对应 _config.yml，部分可在 wrangler.toml [vars] 中配置）
# ----------------------------------------------------------
BLOG_URL=https://blog.zgqinc.gq
WORKER_API_URL=https://api.zgqinc.gq
ASSETS_URL=https://assets.zgqinc.gq
