{
  "name": "blog-worker",
  "version": "2.0.0",
  "description": "Cloudflare Worker for ZGQ Blog - TG Webhook + API Gateway (Python)",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "db:init": "wrangler d1 execute blog-db --file=./schema.sql",
    "db:init:local": "wrangler d1 execute blog-db --local --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.165.0"
  }
}
